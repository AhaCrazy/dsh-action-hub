{
  "name": "dsh-action-hub",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: a Spotlight-style Action shelf for reusable prompts and flows, with search, categories, pinned items, Skill import, and zero context cost.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "action",
    "actions",
    "prompt",
    "snippet",
    "palette",
    "cordis"
  ],
  "license": "MIT",
  "author": "AhaCrazy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhaCrazy/dsh-action-hub.git"
  },
  "homepage": "https://github.com/AhaCrazy/dsh-action-hub#readme",
  "bugs": {
    "url": "https://github.com/AhaCrazy/dsh-action-hub/issues"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Action Hub",
    "description": "Spotlight 式 Action 收藏夹：搜索、分类、置顶与 Skill 导入，插入不占上下文。"
  },
  "scripts": {
    "test": "node tests/store.test.mjs && node tests/client.test.mjs && node tests/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./store": "./store.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "store.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/**",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
